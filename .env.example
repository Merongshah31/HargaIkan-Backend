# Copy to .env for local scripts and notebooks. Placeholder values only.
# The Streamlit app reads .streamlit/secrets.toml first, then these environment variables.

APP_ENV=development

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: offline scripts and notebooks only. Never used by app.py or pages/.
SUPABASE_SERVICE_ROLE_KEY=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=hargaikan-species

# Contact address sent in the Nominatim User-Agent (required for geocoding).
NOMINATIM_CONTACT=you@example.com

MODEL_VERSION=

# FastAPI backend.
# memory = in-process demo data ("Data demo", no credentials needed); supabase = live tables.
# Leave unset to select Supabase. Memory must be selected explicitly for isolated development.
DATA_BACKEND=supabase
# Comma-separated browser origins allowed by CORS. Include the deployed frontend origin.
# Production uses this list exactly. With APP_ENV=development any localhost/127.0.0.1 port is also
# accepted, so `npm run dev` keeps working when Vite falls back to 5174, 5175, ...
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://hargaikan.hargaikan.workers.dev
# Supabase project JWT secret, used by the API to verify user access tokens. Never commit it.
SUPABASE_JWT_SECRET=your-jwt-secret
# Maintained bus/MRT fare table (no fares are invented; the shipped file is empty).
TRANSIT_FARE_TABLE_PATH=data/curated/transit_fares.yaml
# Supply alerts (GET /alerts): free, key-less Open-Meteo forecast API for the weather side.
# Override only to point at a mirror; the Kuala Lumpur coordinates and the alert thresholds are in
# src/hargaikan/services/weather_service.py.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Maintained public-holiday calendar (no festival dates are invented; extend it from kabinet.gov.my).
FESTIVAL_CALENDAR_PATH=data/curated/festivals.yaml
# ManaMurah Data API, read only by the offline audit (scripts/check_manamurah.py). It is not a data
# source: the service currently returns sample rows under a "KPDN_Pricecatcher" label, so the gate in
# src/hargaikan/pipeline/manamurah.py refuses to publish from it. No API route calls it.
MANAMURAH_API_URL=https://api.manamurah.com
# HMAC secret for demo session tokens (memory backend only). Leave blank for a random secret per
# process (demo tokens then stop working after a restart). Never commit a real value.
DEMO_SESSION_SECRET=
