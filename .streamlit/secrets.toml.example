# Copy to .streamlit/secrets.toml (gitignored). Placeholder values only.
# On Streamlit Community Cloud, paste these keys into the app's Secrets settings instead.

APP_ENV = "development"

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-key"
# The deployed app must not use the service role key. Keep it for offline scripts only.
SUPABASE_SERVICE_ROLE_KEY = ""

PINECONE_API_KEY = "your-pinecone-api-key"
PINECONE_INDEX_NAME = "hargaikan-species"

NOMINATIM_CONTACT = "you@example.com"

MODEL_VERSION = ""
# FastAPI backend: "memory" (demo data) or "supabase" (live tables). Leave empty to auto-select.
DATA_BACKEND = "memory"
CORS_ORIGINS = "http://localhost:5173,http://localhost:3000"
SUPABASE_JWT_SECRET = "your-jwt-secret"
TRANSIT_FARE_TABLE_PATH = "data/curated/transit_fares.yaml"
